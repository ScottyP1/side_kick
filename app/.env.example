# Copy to .env.local and fill in. Never commit .env.local.
ANTHROPIC_API_KEY=
# SIDEKICK_MODEL=claude-opus-5-5
# SIDEKICK_MODEL_ASK=claude-sonnet-5-5
# SIDEKICK_MODEL_EXTRACT=claude-opus-5-5
# SIDEKICK_MODEL_INSIGHTS=claude-opus-5-5

# Teams bot (step 2). Leave empty for local Agents Playground testing (npm run dev:teams).
# Filled in once the Azure Bot + Entra app registration exists:
# CLIENT_ID=
# CLIENT_SECRET=
# TENANT_ID=
# Microsoft sign-in (Entra ID) for the portal uses the same Entra app as the bot (CLIENT_ID etc.).
# Add <portal>/api/auth/microsoft/callback as a Web redirect URI on that app. Optional overrides:
# ENTRA_CLIENT_ID=            (a separate app just for sign-in)
# ENTRA_CLIENT_SECRET=
# ENTRA_TENANT=organizations  (let people from any company's tenant sign in; app must be multi-tenant)
# Public address of the portal, used for "Open in Sidekick" links on Teams cards.
# SIDEKICK_PUBLIC_URL=http://localhost:3000

# Azure AI Search (hybrid keyword + meaning search). Leave empty to use local keyword search only.
# AZURE_SEARCH_ENDPOINT=https://<service>.search.windows.net
# AZURE_SEARCH_API_KEY=
# AZURE_SEARCH_INDEX=sidekick-passages
# Embeddings for meaning-based (vector) search, from a Foundry / Azure OpenAI deployment:
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Database. Leave empty for the local SQLite file (app/data). Production: Azure Database for PostgreSQL.
# DATABASE_URL=postgres://user:password@host:5432/sidekick
# DATABASE_POOL_MAX=10

# One-time setup code for the Owner Console (and first-run setup) on a production server: at least 16
# characters. Set it, create the account at /owner/setup, then remove it. Not needed on a laptop (localhost).
# SIDEKICK_SETUP_CODE=

# Self-service sign-up (/signup) is off by default. "true" opens it for this deploy; the Owner Console
# switch (Releases & switches → Self-service sign-up), once flipped, wins over this.
# SIDEKICK_SIGNUP_OPEN=true
