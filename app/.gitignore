# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local data (database, logs)
/data
!.env.example
/.next-test/
/.next-test-*/
/.playground-data/
/.next-playground/
/devTools/
/.next-preview/
/.preview-data/

# throwaway test copies (.claude/launch.json e2e-*: data folders and build folders)
/.e2e-data-*/
/.next-e2e-*/

# answer accuracy check (scripts/answer-eval.mjs): its throwaway build folder
/.next-eval/

# demo world (scripts/seed-demo.mjs, docs/DEMO.md): its data folder, build folders and the private logins (passwords)
/.demo-data/
/.next-demo/
/.next-demo-seed/
/.demo-logins.json
/.demo-logins.md
# a copy of the logins guide, wherever it is put
*demo-logins (LOCAL ONLY)*
# load test (scripts/load-world.mjs, scripts/load-test.mjs, docs/SCALE.md): results, server logs and its build folder
/.load-results/
/.next-load/
