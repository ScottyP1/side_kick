{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:teams": "TEAMS_LOCAL_PLAYGROUND=true SIDEKICK_DATA_DIR=.playground-data NEXT_DIST_DIR=.next-playground next dev --port 3100",
    "dev:preview": "SIDEKICK_DATA_DIR=.preview-data NEXT_DIST_DIR=.next-preview next dev --port 3300",
    "playground": "agentsplayground -e http://localhost:3100/api/messages -c msteams",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "teams:package": "node scripts/teams-package.mjs",
    "help:sync": "node scripts/sync-help.mjs",
    "tunnel": "devtunnel host sidekick",
    "test": "node tests/run.mjs",
    "db:copy-to-postgres": "node scripts/copy-to-postgres.mjs",
    "reset-password": "node --no-warnings scripts/reset-password.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@azure/search-documents": "^13.0.0",
    "@microsoft/teams.api": "^2.1.0",
    "@microsoft/teams.apps": "^2.1.0",
    "@microsoft/teams.cards": "^2.1.0",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.3",
    "jose": "6.2.12",
    "mammoth": "^1.13.0",
    "next": "16.4.1",
    "ogl": "^1.0.11",
    "pg": "^8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@microsoft/m365agentsplayground": "^0.2.29",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "typescript": "^5"
  }
