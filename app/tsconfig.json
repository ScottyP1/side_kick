{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-preview/types/**/*.ts",
    ".next-preview/dev/types/**/*.ts",
    ".next-e2e-d/types/**/*.ts",
    ".next-e2e-d/dev/types/**/*.ts",
    ".next-test-sqlite/types/**/*.ts",
    ".next-test-sqlite/dev/types/**/*.ts",
    ".next-test-postgres/types/**/*.ts",
    ".next-test-postgres/dev/types/**/*.ts",
    ".next-test-mt-sqlite/types/**/*.ts",
    ".next-test-mt-sqlite/dev/types/**/*.ts",
    ".next-m365check/types/**/*.ts",
    ".next-m365check/dev/types/**/*.ts",
    ".next-demo-seed/types/**/*.ts",
    ".next-demo-seed/dev/types/**/*.ts",
    ".next-e2e-c/types/**/*.ts",
    ".next-e2e-c/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
